# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_TALK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-3.8-flash-tts
# Optional: store audits in Firestore (see firestore.rules)
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
